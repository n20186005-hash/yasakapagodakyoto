---
import { getI18n } from '../i18n/ui';
import { entityConfig } from '../config/entity';

const { messages } = getI18n(Astro.url);
const m = messages.mapSection;
const e = messages.entity;
---

<section id="map" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{m.title}</h2>
    <p class="text-center text-base sm:text-lg mb-8" style="color: var(--text-secondary);">{m.subtitle}</p>

    <div class="nap-card" aria-label={e.napTitle}>
      <div class="nap-row">
        <span class="nap-label">{e.officialNameLabel}</span>
        <span class="nap-value">{e.officialName}</span>
      </div>
      <div class="nap-row">
        <span class="nap-label">{e.addressLabel}</span>
        <span class="nap-value">{m.subtitle}</span>
      </div>
      <div class="nap-row">
        <span class="nap-label">{e.phoneLabel}</span>
        <a class="nap-value" href={`tel:${entityConfig.telephone}`}>{entityConfig.telephoneDisplay}</a>
      </div>
    </div>

    <div class="map-container overflow-hidden border" style="border-color: var(--map-border);">
      <iframe
        src={entityConfig.mapsEmbedSrc}
        class="w-full h-[320px] sm:h-[420px]"
        width="100%"
        height="420"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        title={m.title}
      ></iframe>
    </div>

    <div class="text-center mt-8 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href={m.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex w-full sm:w-auto justify-center px-8 py-3 rounded-full font-semibold text-white" style="background: var(--accent);">
        📍 {m.openMaps}
      </a>
      <a href={entityConfig.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="inline-flex w-full sm:w-auto justify-center px-8 py-3 rounded-full font-semibold" style="background: var(--bg-tertiary); color: var(--text-primary); border: 1px solid var(--border-color);">
        {e.tourismLabel} ↗
      </a>
    </div>

    <p class="text-center mt-6 text-sm" style="color: var(--text-secondary);">
      {e.tourismText}
      <a href={entityConfig.govtTourismUrl} target="_blank" rel="noopener noreferrer" style="color: var(--accent);">{e.tourismLabel}</a>
      {e.tourismAfter}
    </p>
  </div>
</section>

<style>
  .nap-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--card-shadow);
  }
  .nap-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border-color);
  }
  .nap-row:last-child {
    border-bottom: none;
  }
  .nap-label {
    min-width: 6rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .nap-value {
    flex: 1 1 0%;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .nap-value[href]:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
